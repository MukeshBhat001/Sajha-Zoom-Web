PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/zoom_recorded_classes
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
CLIENT_ORIGIN=http://localhost:5173

# Zoom Server-to-Server OAuth app credentials
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Use one host with ZOOM_USER_ID or many hosts with ZOOM_USER_IDS.
# Values can be Zoom user IDs or emails. For a single user-level app, "me" may be used.
ZOOM_USER_ID=me
ZOOM_USER_IDS=

# Sync settings
SYNC_ON_START=true
SYNC_INTERVAL_MINUTES=15
ZOOM_SYNC_LOOKBACK_DAYS=30
ZOOM_SYNC_PAGE_SIZE=100
ENABLE_PUBLIC_SYNC_ENDPOINT=true

# Category assignment from recording topic/title.
# JSON format: {"Math":["algebra","geometry"],"Science":["physics","chemistry"]}
# Shorthand format: Math:algebra|geometry;Science:physics|chemistry
DEFAULT_CATEGORY=General
CATEGORY_RULES=
